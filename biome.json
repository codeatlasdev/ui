{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"noNonNullAssertion": "warn",
				"useConst": "error"
			},
			"correctness": {
				"useExhaustiveDependencies": "warn"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"trailingCommas": "es5",
			"semicolons": "always"
		}
	},
	"files": {
		"includes": [
			"**/*.ts",
			"**/*.js",
			"**/*.json",
			"!**/node_modules",
			"!**/dist",
			"!**/build",
			"!**/.turbo",
			"!**/.svelte-kit",
			"!**/.astro",
			"!**/.cache",
			"!**/__screenshots__",
			"!**/.vitest",
			"!**/test-results",
			"!**/playwright-report",
			"!site/src/generated",
			"!site/public/api"
		]
	}
}
