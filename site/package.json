{
	"name": "site",
	"private": true,
	"type": "module",
	"scripts": {
		"brand": "bun scripts/brand.ts",
		"predev": "bun run brand",
		"dev": "astro dev",
		"prebuild": "bun run brand",
		"precheck": "bun run brand",
		"build": "astro build",
		"preview": "astro preview --port 4321 --force",
		"check": "astro check --minimumFailingSeverity warning && tsc -p functions/tsconfig.json && tsc -p functions/tsconfig.test.json",
		"test:unit": "bun test ./functions",
		"test:e2e": "bun ../scripts/test-run.ts playwright test --project=desktop --project=mobile --project=iphone --project=a11y --project=static",
		"test:routes": "E2E_SWEEP=templates bun ../scripts/test-run.ts playwright test --project=routes-desktop --project=routes-mobile --project=axe",
		"test:a11y": "bun ../scripts/test-run.ts playwright test --project=a11y",
		"test:vrt": "bun ../scripts/test-run.ts playwright test --project=visual-desktop --project=visual-mobile",
		"test:vrt:update": "bun ../scripts/test-run.ts playwright test --project=visual-desktop --project=visual-mobile --update-snapshots"
	},
	"dependencies": {
		"@astrojs/mdx": "8.0.3",
		"@astrojs/sitemap": "3.7.4",
		"@astrojs/svelte": "9.0.1",
		"@cloudflare/workers-types": "5.20261015.1",
		"@codeatlasdev/ui": "workspace:*",
		"@deck.gl/core": "9.4.0",
		"@deck.gl/layers": "9.4.0",
		"@deck.gl/mapbox": "9.4.0",
		"@deck.gl/maplibre": "9.4.0",
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@lucide/svelte": "1.55.0",
		"@luma.gl/core": "9.4.2",
		"@math.gl/web-mercator": "4.1.0",
		"@resvg/resvg-js": "2.6.2",
		"@tanstack/svelte-table": "9.3.1",
		"astro": "7.3.8",
		"echarts": "6.1.0",
		"gsap": "3.15.0",
		"lenis": "1.3.26",
		"maplibre-gl": "6.16.0",
		"marked": "18.1.1",
		"png-to-ico": "3.0.2",
		"shiki": "4.5.0",
		"svelte": "5.57.2"
	},
	"devDependencies": {
		"@astrojs/check": "0.9.10",
		"@axe-core/playwright": "4.13.0",
		"@playwright/test": "1.64.0",
		"happy-dom": "21.0.4",
		"typescript": "6.0.3",
		"wrangler": "4.149.0"
	}
}
