---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import { serializeJsonLd } from "@codeatlasdev/ui/seo";
import "@codeatlasdev/ui/styles/global.css";
import "~/styles/site.css";

interface Props {
	title: string;
	description: string;
	/** Absolute or site-relative OG image. */
	image?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	/** Off when the page hosts a package shell (DocsShell, AppShellLayout, AuthLayout): it renders its own skip link and `#main`. */
	skipLink?: boolean;
}
const { title, description, image = "/og.png", noindex = false, jsonLd, skipLink = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const fullTitle = title === "CodeAtlas UI" ? title : `${title} · CodeAtlas UI`;
const ld = jsonLd && serializeJsonLd(jsonLd);
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<meta name="robots" content={noindex ? "noindex,nofollow" : "index,follow,max-image-preview:large"} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="CodeAtlas UI" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="text/plain" href="/llms.txt" title="LLM-readable docs" />
		{ld && <script type="application/ld+json" set:html={ld} />}
		<slot name="head" />
	</head>
	<body>
		{skipLink && <a class="skip-link" href="#main">Skip to content</a>}
		<slot />
		<script>
			// One store instance for every island on the page: theme switches, OS scheme changes
			// and browser chrome color (theme-color / Safari 26 edge sampling) stay in sync.
			import { colorScheme } from "@codeatlasdev/ui";
			colorScheme.init();
		</script>
	</body>
</html>
