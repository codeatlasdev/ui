---
// Full-screen template pages: Base head/SEO, no docs chrome, one island fills the viewport.
import StageTheme from "~/components/gallery/StageTheme.svelte";
import Base from "~/layouts/Base.astro";

interface Props {
	title: string;
	description: string;
	noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
---
<Base title={title} description={description} noindex={noindex} skipLink={false}>
	<!-- Inside the gallery viewer (?scheme=...) the page shows the stage's scheme and preset; on its own it renders nothing. -->
	<StageTheme client:load />
	<slot />
</Base>
