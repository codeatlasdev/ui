---
// Rendered inside the phone frame on the landing page. A real document at a real phone width, so BottomNav,
// Sheet, MobilePane and StickyActions behave exactly as they would in an installed app.
import PhoneApp from "~/components/landing/PhoneApp.svelte";
import StageTheme from "~/components/gallery/StageTheme.svelte";
import Base from "~/layouts/Base.astro";
---
<Base title="Mobile demo" description="Embedded mobile demo of CodeAtlas UI components." noindex>
	<StageTheme client:load />
	<PhoneApp client:load />
</Base>
