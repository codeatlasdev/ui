---
import { readFileSync } from "node:fs";
import { codeToHtml } from "shiki";
import { CardGrid, LinkCard } from "@codeatlasdev/ui";
import { graph, website } from "@codeatlasdev/ui/seo";
import FinaleActions from "~/components/landing/FinaleActions.svelte";
import Chapter from "~/components/landing/Chapter.astro";
import DataShowcase from "~/components/landing/DataShowcase.svelte";
import HeroStage from "~/components/landing/HeroStage.svelte";
import QuickStart from "~/components/landing/QuickStart.svelte";
import Rail from "~/components/landing/Rail.astro";
import ThemeLab from "~/components/landing/ThemeLab.svelte";
import SiteBar from "~/components/site/SiteBar.astro";
import SiteFooter from "~/components/site/SiteFooter.astro";
import HeroPrompt from "~/components/landing/HeroPrompt.svelte";
import Base from "~/layouts/Base.astro";
import catalog from "../../public/api/v1/catalog.json";
import "~/styles/landing.css";

const REPO = "https://github.com/codeatlasdev/ui";
const NPM = "https://www.npmjs.com/package/@codeatlasdev/ui";
const SITE = "https://ui.codeatlas.com.br";

const hl = (code: string, lang: string) =>
	codeToHtml(code.trim(), { lang, themes: { light: "github-light-high-contrast", dark: "github-dark-high-contrast" }, defaultColor: false });

// The "code" of the agents chapter is the literal prompt the catalog emits for #001.
const agentPrompt = readFileSync("public/api/v1/en/p/001.txt", "utf8").trim();

const total = catalog.count;

const install = await Promise.all(
	[
		["bun", "bun add @codeatlasdev/ui"],
		["npm", "npm install @codeatlasdev/ui"],
		["pnpm", "pnpm add @codeatlasdev/ui"],
	].map(async ([label, cmd]) => ({ label, html: await hl(cmd, "bash") })),
);

const setup = await Promise.all(
	[
		[
			"SvelteKit",
			`// vite.config.ts
import { sveltekit } from "@sveltejs/kit/vite";
import { caThemePlugin } from "@codeatlasdev/ui/vite";
import { defineConfig } from "vite";

export default defineConfig({ plugins: [sveltekit(), caThemePlugin()] });

// src/hooks.server.ts
import { sequence } from "@sveltejs/kit/hooks";
import { caThemeHandle } from "@codeatlasdev/ui/kit";

export const handle = sequence(caThemeHandle());`,
		],
		[
			"Astro",
			`// astro.config.mjs
import svelte from "@astrojs/svelte";
import { caUI } from "@codeatlasdev/ui/astro";
import { defineConfig } from "astro/config";

export default defineConfig({
  integrations: [svelte(), caUI({ defaultPreset: "ocean" })],
});`,
		],
	].map(async ([label, code]) => ({ label, html: await hl(code, "ts") })),
);

const title = "CodeAtlas UI";
const description = `Svelte 5 UI as a sketchbook: ${total} numbered screens you pick and your AI reproduces, through MCP, a plugin and skills. One theme object, native-feeling on phones.`;

const jsonLd = graph(
	website({ id: `${SITE}/#website`, name: "CodeAtlas UI", url: `${SITE}/`, description, inLanguage: "en" }),
	{
		"@type": "SoftwareSourceCode",
		"@id": `${SITE}/#code`,
		name: "@codeatlasdev/ui",
		description,
		codeRepository: REPO,
		programmingLanguage: ["Svelte", "TypeScript", "CSS"],
		runtimePlatform: "Svelte 5",
		license: "https://opensource.org/licenses/MIT",
		url: NPM,
		isPartOf: { "@id": `${SITE}/#website` },
	},
);
---
<Base title={title} description={description} jsonLd={jsonLd}>
	<Fragment slot="head">
		<script is:inline>
			(function () {
				var d = document.documentElement;
				if (matchMedia("(prefers-reduced-motion: reduce)").matches) d.classList.add("calm");
				if (matchMedia("(pointer: coarse)").matches || matchMedia("(max-width: 900px)").matches) d.classList.add("touch");
			})();
		</script>
	</Fragment>

	<SiteBar />

	<Rail />

	<main id="main" tabindex="-1" class="landing">
		<section class="hero" aria-labelledby="hero-h">
			<div class="hero__copy">
				<h1 id="hero-h" class="hero__title">
					<span class="rewrite">
						<s class="rewrite__old" data-old>Describe a screen and hope.</s>
						<span class="rewrite__new ca-mark-underline" data-new>Point your AI at page #012.</span>
					</span>
				</h1>
				<p class="hero__lead">
					A Svelte 5 library of {total} numbered, finished screens. Copy one prompt: your AI picks the right ones and builds your app with them.
				</p>
			</div>
			<div class="hero__prompt-wrap">
				<HeroPrompt client:load />
			</div>
		</section>

		<Chapter
			id="pick"
			title="Pick pages, not pixels."
			lead='Every demo in the docs has a number. Filter the gallery, tick the pages you want, and copy one message: "I picked these 3 from the @codeatlasdev/ui gallery: #012 …". A link with ?pick=012,045 is the same selection.'
			layout="wide"
		>
			<div class="pick" data-reveal>
				<CardGrid>
					<LinkCard title="The gallery" href="/gallery/" description={`${total} numbered demos, live.`} />
					<LinkCard title="One page as text: #012" href="/api/v1/en/e/012.txt" description="License line, spec, components and source." />
					<LinkCard title="The whole index as JSON" href="/api/v1/catalog.json" description="Every id, title, tag and component." />
				</CardGrid>
			</div>
		</Chapter>

		<Chapter
			id="agents"
			title="Your AI gets the same page."
			lead="search_demos finds a page by words; get_demo returns its license line, spec, components and source. The skill tells the agent to keep the reference's components, props and motion, and to change only data, copy and theme."
			layout="wide"
		>
			<p class="agents__prompt" data-reveal>
				The prompt at the top of this page is the whole setup. It is also served as plain text at
				<a href="/prompt.txt">/prompt.txt</a>, so you can just tell your AI to follow that URL.
			</p>
			<div class="agents">
				<div class="agents__code"><pre>{agentPrompt}</pre></div>
				<ul class="agents__list">
					<li>
						<strong>MCP server</strong>
						<span><code>npx -y -p @codeatlasdev/ui ca-ui-mcp</code>: search_demos, get_demo, get_component, search_tokens, get_guide.</span>
					</li>
					<li>
						<strong>Claude Code plugin</strong>
						<span><code>/plugin install codeatlas-ui --marketplace codeatlasdev/ui</code>: skills + MCP in one line.</span>
					</li>
					<li>
						<strong>Skills</strong>
						<span><code>npx skills add codeatlasdev/ui</code></span>
					</li>
					<li>
						<strong>llms.txt</strong>
						<span><a href="/llms.txt">A plain-text index</a> of the whole library for any AI to read.</span>
					</li>
				</ul>
			</div>
		</Chapter>

		<Chapter
			id="theme"
			title="One color in, a whole look out."
			lead="Choose a brand color and every button, chart and card follows. Eight ready-made palettes come built in. Light and dark modes switch with no flash, and any part of a page can have its own look."
		>
			<ThemeLab client:visible />
			<HeroStage client:visible />
			<div slot="copy" class="chapter__facts" data-reveal>
				<ul>
					<li>The same settings always give the same result, so design stays predictable.</li>
					<li>Switch between solid, flat, frosted and glass surfaces without touching a component.</li>
					<li>Make any section dark while the rest of the page stays light.</li>
				</ul>
			</div>
		</Chapter>

		<Chapter
			id="mobile"
			title="Feels like an app on a phone."
			lead="Notches, the on-screen keyboard and finger-sized buttons are handled for you. This phone is real: tap the tabs, open the bell for a sheet you can swipe away, open a thread for a full-screen view."
			flip
		>
			<div class="phone" data-reveal="0.1">
				<div class="phone__frame">
					<iframe
						class="phone__screen"
						data-src="/landing-embed/mobile/"
						title="Interactive mobile demo built from CodeAtlas UI components"
						width="390"
						height="760"
					></iframe>
				</div>
				<p class="phone__fallback"><a href="/landing-embed/mobile/">Open the mobile demo in its own page</a></p>
			</div>
			<div slot="copy" class="chapter__facts" data-reveal>
				<ul>
					<li>Bottom tabs, swipe-away sheets, full-screen views and sticky action bars.</li>
					<li>The layout adapts when the keyboard opens instead of jumping.</li>
					<li>Form fields never trigger the iPhone zoom.</li>
				</ul>
			</div>
		</Chapter>

		<Chapter
			id="data"
			title="Charts and tables that already match."
			lead="Hand over your data and get a chart that fits your colors. When the theme changes, the charts change with it. Charts and tables are optional add-ons, so apps that skip them stay small."
			layout="wide"
		>
			<div class="data">
				<DataShowcase client:visible />
			</div>
		</Chapter>

		<Chapter
			id="start"
			title="Three steps, then your AI does the rest."
			lead="Works with SvelteKit and Astro. Install it, add the theme, and start from a ready-made layout."
			layout="wide"
		>
			<QuickStart client:visible {install} {setup} />
		</Chapter>

		<section class="finale" aria-labelledby="finale-h">
			<h2 id="finale-h" class="display" data-rise>Hand them the sketchbook.</h2>
			<div class="finale__actions" data-reveal>
				<FinaleActions repo={REPO} npm={NPM} />
			</div>
		</section>
	</main>

	<SiteFooter />

	<script>
		import { boot, lazyFrames } from "~/lib/landing";
		lazyFrames();
		const run = () => boot();
		if ("requestIdleCallback" in window) requestIdleCallback(run, { timeout: 600 });
		else setTimeout(run, 120);
	</script>
</Base>
