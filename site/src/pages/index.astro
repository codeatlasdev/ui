---
import { codeToHtml } from "shiki";
import { Button } from "@codeatlasdev/ui";
import { graph, website } from "@codeatlasdev/ui/seo";
import FinaleActions from "~/components/landing/FinaleActions.svelte";
import Chapter from "~/components/landing/Chapter.astro";
import DataShowcase from "~/components/landing/DataShowcase.svelte";
import HeroStage from "~/components/landing/HeroStage.svelte";
import QuickStart from "~/components/landing/QuickStart.svelte";
import Rail from "~/components/landing/Rail.astro";
import ThemeLab from "~/components/landing/ThemeLab.svelte";
import Logo from "~/components/Logo.svelte";
import Base from "~/layouts/Base.astro";
import "~/styles/landing.css";

const REPO = "https://github.com/codeatlasdev/ui";
const NPM = "https://www.npmjs.com/package/@codeatlasdev/ui";
const SITE = "https://ui.codeatlas.com.br";

const hl = (code: string, lang: string) =>
	codeToHtml(code.trim(), { lang, themes: { light: "github-light-high-contrast", dark: "github-dark-high-contrast" }, defaultColor: false });

const agentSnippet = await hl(
	`<AppList title="Users" data={users} searchKeys={['name', 'email']} perPage={8}>
  {#snippet actions()}
    <Button variant="filled" href="/users/new">New user</Button>
  {/snippet}

  {#snippet children(list)}
    <SimpleTable>
      {#each list.rows as u (u.id)}
        <tr><td><UserCell name={u.name} email={u.email} /></td></tr>
      {/each}
    </SimpleTable>
  {/snippet}
</AppList>`,
	"svelte",
);

const install = await Promise.all(
	[
		["bun", "bun add @codeatlasdev/ui"],
		["npm", "npm install @codeatlasdev/ui"],
		["pnpm", "pnpm add @codeatlasdev/ui"],
	].map(async ([label, cmd]) => ({ label, html: await hl(cmd, "bash") })),
);

const setup = await Promise.all(
	[
		[
			"SvelteKit",
			`// vite.config.ts
import { sveltekit } from "@sveltejs/kit/vite";
import { caThemePlugin } from "@codeatlasdev/ui/vite";
import { defineConfig } from "vite";

export default defineConfig({ plugins: [sveltekit(), caThemePlugin()] });

// src/hooks.server.ts
import { sequence } from "@sveltejs/kit/hooks";
import { caThemeHandle } from "@codeatlasdev/ui/kit";

export const handle = sequence(caThemeHandle());`,
		],
		[
			"Astro",
			`// astro.config.mjs
import svelte from "@astrojs/svelte";
import { caUI } from "@codeatlasdev/ui/astro";
import { defineConfig } from "astro/config";

export default defineConfig({
  integrations: [svelte(), caUI({ defaultPreset: "ocean" })],
});`,
		],
	].map(async ([label, code]) => ({ label, html: await hl(code, "ts") })),
);

const title = "CodeAtlas UI";
const description =
	"Ready-made screens for Svelte apps: dashboards, lists, forms and mobile layouts that look right out of the box, restyle from one color, and that AI assistants write correctly the first time.";

const jsonLd = graph(
	website({ id: `${SITE}/#website`, name: "CodeAtlas UI", url: `${SITE}/`, description, inLanguage: "en" }),
	{
		"@type": "SoftwareSourceCode",
		"@id": `${SITE}/#code`,
		name: "@codeatlasdev/ui",
		description,
		codeRepository: REPO,
		programmingLanguage: ["Svelte", "TypeScript", "CSS"],
		runtimePlatform: "Svelte 5",
		license: "https://opensource.org/licenses/MIT",
		url: NPM,
		isPartOf: { "@id": `${SITE}/#website` },
	},
);
import SendPrompt from "~/components/landing/SendPrompt.svelte";
---
<Base title={title} description={description} jsonLd={jsonLd}>
	<Fragment slot="head">
		<script is:inline>
			(function () {
				var d = document.documentElement;
				if (matchMedia("(prefers-reduced-motion: reduce)").matches) d.classList.add("calm");
				if (matchMedia("(pointer: coarse)").matches || matchMedia("(max-width: 900px)").matches) d.classList.add("touch");
			})();
		</script>
	</Fragment>

	<header class="bar">
		<a class="bar__brand" href="/" aria-label="CodeAtlas UI home">
			<Logo />
			<span>CodeAtlas UI</span>
		</a>
		<nav class="bar__nav" aria-label="Primary">
			<a href="/docs/">Docs</a>
			<a href={REPO} rel="noopener">GitHub</a>
			<Button size="sm" href="/docs/">Get started</Button>
		</nav>
	</header>

	<Rail />

	<main id="main" tabindex="-1" class="landing">
		<section class="hero" aria-labelledby="hero-h">
			<div class="hero__copy">
				<h1 id="hero-h" class="hero__title">
					<span class="rewrite">
						<s class="rewrite__old" data-old>Describing a UI to an AI.</s>
						<span class="rewrite__new ca-mark-underline" data-new>Screens it builds right the first time.</span>
					</span>
				</h1>
				<p class="hero__lead">
					CodeAtlas UI gives your Svelte app finished screens: dashboards, lists, forms and a phone layout that
					feels native. Pick one brand color and the whole app follows. Names are plain, so people and AI
					assistants both get it right.
				</p>
				<div class="hero__actions">
					<Button size="lg" href="/docs/">Read the docs</Button>
					<Button size="lg" variant="outlined" href={REPO}>See it on GitHub</Button>
				</div>
			</div>
			<div class="hero__stage">
				<HeroStage client:load />
				<p class="hero__caption ca-mark-note">
					This is a real, working screen, not a picture. Try the buttons, then change its colors below.
				</p>
			</div>
		</section>

		<Chapter
			id="theme"
			title="One color in, a whole look out."
			lead="Choose a brand color and every button, chart and card follows. Eight ready-made palettes come built in. Light and dark modes switch with no flash, and any part of a page can have its own look."
		>
			<ThemeLab client:visible />
			<div slot="copy" class="chapter__facts" data-reveal>
				<ul>
					<li>The same settings always give the same result, so design stays predictable.</li>
					<li>Switch between solid, flat, frosted and glass surfaces without touching a component.</li>
					<li>Make any section dark while the rest of the page stays light.</li>
				</ul>
			</div>
		</Chapter>

		<Chapter
			id="mobile"
			title="Feels like an app on a phone."
			lead="Notches, the on-screen keyboard and finger-sized buttons are handled for you. This phone is real: tap the tabs, open the bell for a sheet you can swipe away, open a thread for a full-screen view."
			flip
		>
			<div class="phone" data-reveal="0.1">
				<div class="phone__frame">
					<iframe
						class="phone__screen"
						data-src="/landing-embed/mobile/"
						title="Interactive mobile demo built from CodeAtlas UI components"
						width="390"
						height="760"
					></iframe>
				</div>
				<p class="phone__fallback"><a href="/landing-embed/mobile/">Open the mobile demo in its own page</a></p>
			</div>
			<div slot="copy" class="chapter__facts" data-reveal>
				<ul>
					<li>Bottom tabs, swipe-away sheets, full-screen views and sticky action bars.</li>
					<li>The layout adapts when the keyboard opens instead of jumping.</li>
					<li>Form fields never trigger the iPhone zoom.</li>
				</ul>
			</div>
		</Chapter>

		<Chapter
			id="agents"
			title="AI assistants get it right on the first try."
			lead="Component names say what a screen is, and props are just your data. There are no styling choices left for an assistant to guess."
			layout="wide"
		>
			<div class="agents__prompt" data-reveal>
				<SendPrompt client:visible />
			</div>
			<div class="agents">
				<div class="agents__code" set:html={agentSnippet} />
				<ul class="agents__list">
					<li>
						<strong>Typed props</strong>
						<span>Every component describes what it accepts, so editors and AI assistants know the rules.</span>
					</li>
					<li>
						<strong>llms.txt</strong>
						<span><a href="/llms.txt">A plain-text index</a> of the whole library for any AI to read.</span>
					</li>
					<li>
						<strong>AGENTS.md</strong>
						<span>
							<a href={`${REPO}/blob/main/AGENTS.md`} rel="noopener">A rules file</a> with layouts, colors and the mistakes to avoid.
						</span>
					</li>
					<li>
						<strong>Ready-made skills</strong>
						<span>Teach your assistant the library with <code>npx skills add codeatlasdev/ui</code>.</span>
					</li>
				</ul>
			</div>
		</Chapter>

		<Chapter
			id="data"
			title="Charts and tables that already match."
			lead="Hand over your data and get a chart that fits your colors. When the theme changes, the charts change with it. Charts and tables are optional add-ons, so apps that skip them stay small."
			layout="wide"
		>
			<div class="data">
				<DataShowcase client:visible />
			</div>
		</Chapter>

		<Chapter
			id="quality"
			title="Works for everyone."
			lead="Keyboard, screen readers and high-contrast modes are built in, following the WAI-ARIA patterns. Every component is tested in a real browser, and this page is built with the same components."
			layout="wide"
		>
			<dl class="facts">
				<div>
					<dt>Accessibility checks</dt>
					<dd>80 component test suites</dd>
				</div>
				<div>
					<dt>Looks the same everywhere</dt>
					<dd>77 screenshot test suites</dd>
				</div>
				<div>
					<dt>Ready-made palettes</dt>
					<dd>8, plus your own from one color</dd>
				</div>
				<div>
					<dt>Optional add-ons</dt>
					<dd>Charts, tables and code blocks load only if you use them</dd>
				</div>
			</dl>
		</Chapter>

		<Chapter
			id="start"
			title="Up and running in three steps."
			lead="Works with SvelteKit and Astro. Install it, add the theme, and start from a ready-made layout."
			layout="wide"
		>
			<QuickStart client:visible {install} {setup} />
		</Chapter>

		<section class="finale" aria-labelledby="finale-h">
			<h2 id="finale-h" class="display" data-rise>Build the screen. Skip the styling.</h2>
			<div class="finale__actions" data-reveal>
				<FinaleActions repo={REPO} npm={NPM} />
			</div>
		</section>
	</main>

	<footer class="foot">
		<p>
			Free and open source (MIT). Built with Svelte 5. Interaction patterns inspired by
			<a href="https://bits-ui.com" rel="noopener">Bits UI</a>.
		</p>
		<nav aria-label="Footer">
			<a href="/docs/">Docs</a>
			<a href={REPO} rel="noopener">GitHub</a>
			<a href={NPM} rel="noopener">npm</a>
			<a href="/llms.txt">llms.txt</a>
		</nav>
	</footer>

	<script>
		import { boot, lazyFrames } from "~/lib/landing";
		lazyFrames();
		const run = () => boot();
		if ("requestIdleCallback" in window) requestIdleCallback(run, { timeout: 600 });
		else setTimeout(run, 120);
	</script>
</Base>
