---
import { render } from "astro:content";
import SiteDocsShell from "~/components/docs/SiteDocsShell.svelte";
import Base from "~/layouts/Base.astro";
import { loadDocs } from "~/lib/docs";
import { docHref, SECTIONS } from "~/lib/nav";

export async function getStaticPaths() {
	const { entries } = await loadDocs();
	return entries.map((entry) => ({ params: { slug: entry.id === "index" ? undefined : entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { groups, flat } = await loadDocs();
const { Content, headings } = await render(entry);
const toc = headings
	.filter((h) => h.depth === 2 || h.depth === 3)
	.map((h) => ({ id: h.slug, text: h.text, depth: h.depth as 2 | 3 }));
const i = flat.findIndex((d) => d.slug === entry.id);
const prev = flat[i - 1];
const next = flat[i + 1];
const edit = `https://github.com/codeatlasdev/ui/edit/main/site/src/content/docs/${entry.filePath?.split("content/docs/")[1] ?? ""}`;
---
<Base title={entry.data.title} description={entry.data.description} skipLink={false}>
	<SiteDocsShell client:load sections={SECTIONS} active="docs" {groups} pathname={Astro.url.pathname} headings={toc}>
		<article class="ca-prose doc">
			<p class="doc__eyebrow">{entry.data.group}</p>
			<h1>{entry.data.title}</h1>
			<p class="doc__lead">{entry.data.description}</p>
			<Content />
			<footer class="doc__footer">
				<a href={edit} rel="noopener">Edit this page on GitHub</a>
				<nav aria-label="Pagination" class="doc__pager">
					{prev && <a href={docHref(prev.slug)} rel="prev"><small>Previous</small>{prev.title}</a>}
					{next && <a href={docHref(next.slug)} rel="next"><small>Next</small>{next.title}</a>}
				</nav>
			</footer>
		</article>
	</SiteDocsShell>
</Base>
