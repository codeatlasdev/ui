---
import { CodeSnippet } from "@codeatlasdev/ui/code";
import catalog from "../../../public/api/v1/catalog.json";
import { headingId, slugOf } from "../../lib/heading-ids";

interface Props {
	title: string;
	description?: string;
	/** Source of the demo component (import with `?raw`). */
	src?: string;
	/** Center the preview in a framed stage. */
	stage?: boolean;
}
const { title, description, src, stage = false } = Astro.props;
// The catalog slug (packages/ui/scripts/build-manifest.ts) is slugOf(title); the heading id is that slug
// unless the page already uses it (see lib/heading-ids.ts).
const slug = slugOf(title);
const id = headingId(Astro.url.pathname, title, true);
// `/docs/<group>/<page>/` identifies the page; with the slug it identifies the numbered demo.
const [, , group, page] = Astro.url.pathname.split("/");
const num = catalog.elements.find((e) => e.group === group && e.page === page && e.slug === slug)?.id;
---
<section class="demo sk-page" aria-labelledby={id}>
	{num && <span class="sk-page__num">#{num}</span>}
	<h2 id={id}>{title}</h2>
	{description && <p class="demo__desc">{description}</p>}
	<div class:list={["demo__preview", { "demo__preview--stage": stage }]}>
		<slot />
	</div>
	{num && (
		<p class="demo__ref sk-caption">
			<a href={`/api/v1/en/e/${num}.txt`}>Reference #{num}</a> · <a href={`/gallery/?pick=${num}`}>Pick in the gallery</a>
		</p>
	)}
	{src && (
		<details class="demo__code">
			<summary>Code</summary>
			<CodeSnippet client:visible code={src.trim()} language="svelte" />
		</details>
	)}
</section>
