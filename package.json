{
	"name": "codeatlasdev-ui",
	"private": true,
	"packageManager": "bun@1.4.3",
	"type": "module",
	"engines": {
		"node": ">=22.17.0",
		"bun": ">=1.4.3"
	},
	"workspaces": [
		"packages/*",
		"site"
	],
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"build": "bun run --cwd packages/ui build && bun run --cwd site build",
		"build:pkg": "bun run --cwd packages/ui build",
		"preview": "bun run --cwd site preview",
		"check": "bun run check:native && bun run check:svelte && bun run check:astro",
		"check:native": "bun --check",
		"check:svelte": "bun run --cwd packages/ui check",
		"check:astro": "bun run --cwd site check",
		"lint": "biome check .",
		"format": "biome format --write .",
		"changeset": "changeset",
		"version": "changeset version && bun install --lockfile-only",
		"release": "node scripts/release.js",
		"release:tag": "bun scripts/release-tag.ts",
		"clean": "rm -rf packages/ui/dist site/dist site/.astro",
		"lint:fix": "biome check --write .",
		"validate": "bun scripts/validate.ts",
		"postinstall": "node scripts/fix-ts-symlink.js && node scripts/install-hooks.js && bunx playwright install chromium",
		"test": "bun run test:unit && bun run test:browser && bun run test:e2e",
		"test:unit": "bun run --cwd packages/ui test:unit",
		"test:browser": "bun run --cwd packages/ui test:browser",
		"test:watch": "bun run --cwd packages/ui test:watch",
		"test:e2e": "bun run --cwd site test:e2e",
		"test:a11y": "bun run --cwd site test:a11y",
		"issue:start": "bun scripts/issue.ts start",
		"issue:status": "bun scripts/issue.ts status",
		"issue:done": "bun scripts/issue.ts done",
		"test:vrt:update": "sh scripts/vrt-update-ci.sh",
		"test:reap": "bun scripts/test-run.ts --reap",
		"test:status": "bun scripts/test-run.ts --status"
	},
	"dependencies": {
		"@lucide/svelte": "1.55.0",
		"svelte": "5.57.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@changesets/cli": "3.0.3",
		"@types/bun": "1.4.3",
		"@types/node": "24.19.2",
		"lefthook": "2.2.1",
		"typescript": "6.0.3"
	}
}
