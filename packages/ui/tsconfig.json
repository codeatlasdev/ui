{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noImplicitAny": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node", "@sveltejs/kit", "vitest/browser", "vitest-browser-svelte"],
		"lib": ["ESNext", "DOM", "DOM.Iterable"]
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts"],
	// Unit tests run on `bun test` and are type-checked by `bun --check` (root tsconfig.json).
	"exclude": ["tests/*.test.ts", "tests/setup.unit.ts", "tests/stub-global.ts"]
}
