{
	"compilerOptions": {
		"target": "ESNext",
		"useDefineForClassFields": true,
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noImplicitAny": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["node", "@sveltejs/kit", "vitest/browser", "vitest-browser-svelte"],
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		// Scaffold templates (kit/templates) import the package by name, as the app they are copied
		// into will. Resolve that to the source: through `exports` it would read dist/, which the
		// parallel `build` step of `validate` is rewriting at the same time.
		"paths": { "@codeatlasdev/ui": ["./src/lib/index.ts"] }
	},
	"include": ["src/**/*.ts", "src/**/*.svelte", "tests/**/*.ts"],
	// Unit tests run on `bun test` and are type-checked by `bun --check` (root tsconfig.json).
	"exclude": ["tests/*.test.ts", "tests/setup.unit.ts", "tests/stub-global.ts"]
}
