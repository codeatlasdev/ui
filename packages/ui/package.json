{
	"name": "@codeatlasdev/ui",
	"version": "1.0.0",
	"description": "Svelte 5 UI framework. DX-first, AI-ready. Build complete interfaces with zero CSS decisions.",
	"license": "MIT",
	"author": "codeatlasdev",
	"homepage": "https://github.com/codeatlasdev/ui#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/codeatlasdev/ui.git",
		"directory": "packages/ui"
	},
	"bugs": {
		"url": "https://github.com/codeatlasdev/ui/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"ui",
		"ui-framework",
		"design-system",
		"components",
		"dx",
		"ai-friendly",
		"sveltekit",
		"oklch",
		"liquid-glass",
		"bits-ui",
		"datatable",
		"appshell"
	],
	"type": "module",
	"engines": {
		"node": ">=22.12.0",
		"bun": ">=1.0.0"
	},
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"sideEffects": [
		"**/*.css"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./charts": {
			"types": "./dist/charts/index.d.ts",
			"svelte": "./dist/charts/index.js",
			"default": "./dist/charts/index.js"
		},
		"./table": {
			"types": "./dist/components/DataTable/index.d.ts",
			"svelte": "./dist/components/DataTable/index.js",
			"default": "./dist/components/DataTable/index.js"
		},
		"./code": {
			"types": "./dist/components/CodeSnippet/index.d.ts",
			"svelte": "./dist/components/CodeSnippet/index.js",
			"default": "./dist/components/CodeSnippet/index.js"
		},
		"./forms": {
			"types": "./dist/forms/index.d.ts",
			"svelte": "./dist/forms/index.js",
			"default": "./dist/forms/index.js"
		},
		"./styles/global.css": "./dist/styles/global.css",
		"./styles/materials.css": "./dist/styles/materials.css",
		"./tokens": {
			"types": "./dist/tokens/index.d.ts",
			"default": "./dist/tokens/index.js"
		},
		"./utils/palette-generator": {
			"types": "./dist/utils/palette-generator.d.ts",
			"default": "./dist/utils/palette-generator.js"
		},
		"./vite": {
			"types": "./dist/vite-plugin.d.ts",
			"default": "./dist/vite-plugin.js"
		},
		"./astro": {
			"types": "./dist/astro.d.ts",
			"default": "./dist/astro.js"
		},
		"./actions": {
			"types": "./dist/actions/index.d.ts",
			"default": "./dist/actions/index.js"
		},
		"./kit": {
			"types": "./dist/kit/index.d.ts",
			"default": "./dist/kit/index.js"
		},
		"./seo": {
			"types": "./dist/seo/index.d.ts",
			"svelte": "./dist/seo/index.js",
			"default": "./dist/seo/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"scripts": {
		"build": "svelte-package -i src/lib && node ../../scripts/prune-dist.js dist",
		"check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"build:watch": "svelte-package -i src/lib --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:unit": "vitest run --project unit",
		"test:browser": "vitest run --project browser",
		"test:vrt": "vitest run --project vrt --maxWorkers=2",
		"test:vrt:update": "vitest run --project vrt --maxWorkers=2 --update",
		"test:ui": "vitest --ui",
		"themes": "bun scripts/build-themes.ts",
		"themes:check": "bun scripts/build-themes.ts --check"
	},
	"dependencies": {
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.48.0",
		"bits-ui": "2.3.1",
		"clsx": "2.1.1",
		"esm-env": "1.2.2"
	},
	"devDependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@fontsource-variable/jetbrains-mono": "5.3.0",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/package": "2.5.8",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tanstack/svelte-table": "9.2.4",
		"@types/node": "22.20.4",
		"@vitest/browser-playwright": "5.0.3",
		"@vitest/ui": "5.0.3",
		"astro": "7.3.8",
		"axe-core": "4.14.0",
		"echarts": "6.1.0",
		"happy-dom": "21.0.1",
		"playwright": "1.64.0",
		"shiki": "4.4.3",
		"svelte": "5.57.0",
		"svelte-check": "4.7.6",
		"typescript": "5.9.3",
		"vite": "8.3.0",
		"vitest": "5.0.3",
		"vitest-browser-svelte": "3.1.0"
	},
	"peerDependencies": {
		"svelte": "^5.33.0",
		"@sveltejs/kit": "^2.12.0 || ^3.0.0",
		"echarts": "^6.0.0",
		"@tanstack/svelte-table": "^9.2.4",
		"shiki": "^4.0.0",
		"astro": "^5.0.0 || ^6.0.0 || ^7.0.0"
	},
	"publishConfig": {
		"registry": "https://registry.npmjs.org",
		"access": "public"
	},
	"peerDependenciesMeta": {
		"@sveltejs/kit": {
			"optional": true
		},
		"echarts": {
			"optional": true
		},
		"@tanstack/svelte-table": {
			"optional": true
		},
		"shiki": {
			"optional": true
		},
		"astro": {
			"optional": true
		}
	}
}
